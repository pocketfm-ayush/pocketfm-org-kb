{
  "name": "pocket_search",
  "language": "python",
  "framework": "django",
  "pack_path": "search",
  "graph_path": "search/graphify/graphify-out/graph.json",
  "knowledge_base_path": "search/knowledge-base",
  "test_command": "make test",
  "test_command_v2": "make test-v2",
  "test_command_v3": "make test-v3",
  "check_command": "make lint",
  "coverage_command": "make test-coverage",
  "max_repair_iterations": 3,
  "allowed_edit_paths": [
    "v2/search/**",
    "v3/search/**",
    "v2/experiments/**"
  ],
  "protected_paths": [
    "mind/**",
    "skills/**",
    "agent/**",
    "graphify/**",
    "knowledge-base/**",
    ".env",
    "**/dev.env",
    "**/qa.env",
    "**/preprod.env",
    "**/prod.env",
    "radioly_api/secrets_manager.py",
    "radioly_api/secret_key_mapping.py",
    "authorization_json"
  ],
  "source_files_priority": [
    "v3/search/views.py",
    "v3/search/urls.py",
    "v3/search/data/request_data.py",
    "v3/search/utils/request_parser.py",
    "v3/search/services/show_search_v3.py",
    "v3/search/services/show_filter_v3.py",
    "v3/search/services/genre_trope_service.py",
    "v3/search/services/genre_service.py",
    "v3/search/services/trope_service.py",
    "v2/search/views.py",
    "v2/search/urls.py",
    "v2/search/services/show_search.py",
    "v2/search/services/lang_biased_search.py",
    "v2/search/services/search_response_service.py",
    "v2/search/services/me_show_exclusion_service.py",
    "v2/search/services/override_show_filter_service.py",
    "v2/search/services/ai_pgc_show_service.py",
    "v2/search/services/campaign_only_show_service.py",
    "v2/search/services/show_thumbnail.py",
    "v2/search/services/user_disabled_show_removal_service.py",
    "v2/search/query_processing.py",
    "v2/search/cache_key_utils.py",
    "v2/search/es_search_functions.py",
    "v2/search/sort_filter_utils.py"
  ],
  "test_paths": [
    "v2/search/tests/**",
    "v3/search/tests/**"
  ],
  "external_systems": [
    "elasticsearch",
    "redis",
    "scylla",
    "mysql",
    "radioly_api",
    "appsflyer"
  ],
  "mocking_rules": "Unit/BDD tests must not open Redis, Cassandra/Scylla, or Elasticsearch. Follow _stub_infra_modules() in v3/search/tests/test_v3_universal_search_bdd.py; stub new import-chain modules the same way.",
  "repo_url": "https://github.com/Pocket-Fm/pocket_search"
}
