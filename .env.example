# Org Brain engine → this instance
ORG_BRAIN_INSTANCE=.
ORG_BRAIN_DATABASE_URL=sqlite+pysqlite:///./var/orgbrain.db
# Production-like:
# ORG_BRAIN_DATABASE_URL=postgresql+psycopg://orgbrain:orgbrain@localhost:5432/orgbrain

# Optional models (leave unset for extract/answer disabled)
# ORG_BRAIN_EXTRACTION_MODEL=
# ORG_BRAIN_ANSWER_MODEL=

# Sibling checkouts (override if not ../ layout)
# PFM_CKB_PATH=../content-knowledge-base
# PFM_CEREBRO_PATH=../cerebro-knowledge
# PFM_GROOT_PATH=../groot
