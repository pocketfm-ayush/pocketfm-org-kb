{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketfm.local/schemas/entity.schema.json",
  "title": "HandbookEntityFrontmatter",
  "type": "object",
  "required": ["id", "type", "repository", "status", "evidence"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["flow", "interface", "capability", "service", "module"]
    },
    "repository": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["established", "uncertain", "deprecated"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    }
  }
}
